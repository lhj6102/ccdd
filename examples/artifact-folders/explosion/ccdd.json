  "critics": [
    {
      "id": "coding-style",
      "title": "Check script conventions",
      "profile": {
        "kind": "agent",
        "provider": "openai-codex",
        "model": "gpt-6-astra",
        "reasoning": "medium"
      },
      "payload": {
        "instruction": "Read the script in {explosion} and the rules in {style}. Decide whether the script follows those rules and keeps the Artifact boundary."
      }
    },
    {
      "id": "appearance",
      "title": "Compare the anonymous theme and preview",
      "profile": {
        "kind": "agent",
        "provider": "openai-codex",
        "model": "gpt-6-astra",
        "reasoning": "medium"
      },
      "payload": {
        "instruction": "Use blind_pair on {explosion}. Compare images A and B without opening named image views. Decide whether their palette and shape match; cite visible differences. Animation and runtime behavior are outside this static review."
      }
    },
    {
      "id": "description",
      "title": "Match the effect description",
      "profile": {
        "kind": "agent",
        "provider": "openai-codex",
        "model": "gpt-6-astra",
        "reasoning": "medium"
      },
      "payload": {
        "instruction": "Inspect {explosion}, {effect} and {preview}; decide whether the static preview matches the description."
      }
    }
  ]
