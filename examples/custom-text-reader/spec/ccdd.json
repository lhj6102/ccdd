{
  "name": "spec",
  "views": {
    "agentTools": {
      "read": {
        "metadata": {
          "description": "Inspect {artifactName} with read.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "lineCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 80
              }
            },
            "additionalProperties": false,
            "required": [
              "startLine",
              "lineCount"
            ]
          },
          "resultKinds": [
            "json"
          ],
          "observation": "content",
          "executionPaths": [
            "view.mjs"
          ]
        },
        "script": {
          "command": "node",
          "args": [
            "../view.mjs",
            "spec.md"
          ]
        }
      }
    }
  },
  "critics": [
    {
      "id": "alignment",
      "title": "Does Spec match Why?",
      "profile": {
        "kind": "agent",
        "provider": "openai-codex",
        "model": "gpt-6-astra",
        "reasoning": "medium"
      },
      "payload": {
        "instruction": "Read {spec} and {why}; decide whether Spec satisfies the maximum task count in Why."
      }
    }
  ]
}
