{
  "name": "@lhj6102/ccdd",
  "version": "0.6.0",
  "private": true,
  "description": "Daemon-free critic broker and artifact runner with whole-workspace lock/copy",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ccdd": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "demo:prepare": "npm run build && node dist/src/cli.js prepare-demo",
    "demo": "npm run build && node dist/src/cli.js run --demo --copy --wait"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7"
  },
  "files": [
    "dist/src/",
    "dist/scripts/",
    "README.md",
    "docs/",
    "CONTEXT-MAP.md",
    "src/**/CONTEXT.md"
  ],
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
